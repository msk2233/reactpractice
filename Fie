import { Column, Entity } from 'typeorm';
import { AbstractEntity } from '../../database/entity/abstract.entity';

@Entity('questions')
export class Result extends AbstractEntity<Result> {
  @Column()
  right_answers: number;

  @Column()
  wrong_answers: number;

  @Column({
    default: () => 4 * this.right_answers - this.wrong_answers,
  })
  obatined_marks: number;

  @Column({
    type: 'boolean',
  })
  absent_or_present: boolean;
}
