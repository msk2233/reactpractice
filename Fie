{
  "name": "typeorm-sample",
  "version": "0.0.1",
  "description": "Awesome project developed with TypeORM.",
  "devDependencies": {
    "ts-node": "10.9.1",
    "@types/node": "^16.11.10",
    "typescript": "4.5.2"
  },
  "dependencies": {
    "typeorm": "0.3.20",
    "reflect-metadata": "^0.1.13",
    "pg": "^8.4.0"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "typeorm": "typeorm-ts-node-commonjs",
   "migration:run": "npm run typeorm migration:run -- -d ./src/data-source.ts",
    "migration:generate": "npm run typeorm -- -d ./src/data-source.ts migration:generate ./src/migration/$npm_config_name",
    "migration:create": "npm run typeorm -- migration:create ./src/migration/$npm_config_name",
    "migration:revert": "npm run typeorm -- -d ./src/data-source.ts migration:revert"
  },
  "_moduleAliases": {
    "src": "./src"
  }
}


import { DataSource } from "typeorm";
import { config } from "dotenv";
config();

export default new DataSource({
  type: "postgres",
  host: process.env.DATABASE_HOST,
  port: +process.env.DATABASE_PORT,
  username: process.env.DATABASE_USER,
  password: process.env.DATABASE_PASSWORD,
  database: process.env.DATABASE_DB,
  dropSchema: false,
  logging: false,
  // entities: ["./entity//.ts"],
  // migrations: ["./migration/**/.ts"],
  entities: ["src/entities/**/*.ts"],
  migrations: ["src/migration/**/*.ts"],
  // seed:[__dirname + 'src/seeder/*.ts'],,'src/seeder/seed.ts'
  synchronize: false,
});


