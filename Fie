"scripts": {
  "build": "nest build",
  "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
  "start": "nest start",
  "start:dev": "nest start --watch",
  "start:debug": "nest start --debug --watch",
  "start:prod": "node dist/main",
  "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
  "test": "jest",
  "test:watch": "jest --watch",
  "test:cov": "jest --coverage",
  "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
  "test:e2e": "jest --config ./test/jest-e2e.json",
  "typeorm": "ts-node ./node_modules/typeorm/cli",
  "migration:run": "npm run build && npm run typeorm migration:run -- -d ./dist/src/database/typeorm.js",
  "migration:generate": "npm run build && npm run typeorm migration:generate -- -d ./dist/src/database/typeorm.js ./dist/src/migrations/$npm_config_name",
  "migration:create": "npm run build && npm run typeorm migration:create ./dist/src/migrations/$npm_config_name",
  "migration:revert": "npm run build && npm run typeorm migration:revert -- -d ./dist/src/database/typeorm.js"
}
