import { Request, Response } from "express";
import dataSource from "../src/data-source";
import { Questions } from '../src/entities/questions';
import { exam } from '../src/entities/exam';

const QueRepo = dataSource.getRepository(Questions);
const ExamRepo = dataSource.getRepository(exam);

export const InsertQue = async (req: Request, res: Response) => {
    const { question_title, exam_id } = req.body;
    console.log(req.body);

    try {
        // Find the exam by ID
        const examInstance = await ExamRepo.findOne({ where: { id: exam_id } });

        if (!examInstance) {
            return res.status(404).json({ message: "Exam not found" });
        }

        // Create a new question instance and associate it with the found exam
        const newQuestion = QueRepo.create({ question_title, Exam: examInstance });

        // Save the new question
        const insdata = await QueRepo.save(newQuestion);

        res.json(insdata);
    } catch (err) {
        console.log(err);
        res.status(500).json(err);
    }
}
