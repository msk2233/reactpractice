// Deals.tsx
import React, { useEffect, useState } from "react";
import { useNavigate } from "react-router-dom";
import Navbar from "../common/Navbar";
import Button from "../common/Button";
import Input from "../common/Input";
import Pagination from "../common/Pagination";
import Modal from "../common/Modal";
import { DealInterface, ParamsInterface } from "../../Interface/interface";
import dealService from "./deal.service";
import DealForm from "./DealForm";
import { SubmitHandler } from "react-hook-form";
import initialParams from "../../constants/constants";
import Table from "../common/Table";

const initialValue = {
  title: "",
  amount: 0,
  stage: "Prospecting",
};

const Deals: React.FC = () => {
  const navigate = useNavigate();
  const paramsInitials = initialParams("title", 5);
  const [deals, setDeals] = useState<DealInterface[]>([]);
  const [showForm, setShowForm] = useState(false);
  const [update, setUpdate] = useState<boolean>(false);
  const [params, setParams] = useState(paramsInitials);
  const [totalPages, setTotalPages] = useState(1);
  const [currentDeal, setCurrentDeal] = useState<DealInterface | null>(null);
  const { fetchDealsApi, deleteDealApi, updateeDealApi, createDealApi } = dealService();

  const fetchDeals = async (params: ParamsInterface) => {
    try {
      const res = await fetchDealsApi(params);
      setTotalPages(res?.data.totalPage || 1);
      setParams(paramsInitials);
      setDeals([...res?.data.res]);
    } catch (error) {
      console.error("Error fetching deals:", error);
    }
  };

  useEffect(() => {
    fetchDeals(params);
  }, []);

  const deleteDeal = async (id: string | undefined) => {
    try {
      await deleteDealApi(id);
      fetchDeals(params);
    } catch (error) {
      console.error("Error deleting deal:", error);
    }
  };

  const handleFormSubmit: SubmitHandler<DealInterface> = async (data) => {
    const dataTosubmit = {
      title: data.title,
      amount: data.amount,
      stage: data.stage,
      closedate: data.closedate,
    };
    if (update && currentDeal?.id) {
      const id = currentDeal.id;
      await updateeDealApi(id, dataTosubmit);
    } else {
      const res = await createDealApi(dataTosubmit);
      setDeals([...deals, res?.data]);
    }
    setCurrentDeal(null);
    setShowForm(false);
    fetchDeals(params);
  };

  const findDeal = async (id: string | undefined) => {
    if (id) {
      navigate(`/edit-deal/${id}`);
    }
  };

  const handlePageChange = async (page: number) => {
    params.page = page;
    const res = await fetchDealsApi(params);
    setDeals([...res?.data.res]);
  };

  const columns = [
    { header: "Title", accessor: "title" },
    { header: "Amount", accessor: "amount" },
    { header: "Stage", accessor: "stage" },
    { header: "Close Date", accessor: "closedate" },
  ];

  return (
    <>
      <Navbar />
      <section className="bg-gray-50 light:bg-gray">
        <div className="flex flex-col items-center justify-center lg:py-0">
          <div className="w-full max-w-9xl bg-white rounded-lg light:border mt-4 light:bg-gray-800 light:border-gray-700">
            <div className="p-6 space-y-4 md:space-y-6 sm:p-8">
              <h1 className="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl light:text-white">
                Deal Records
              </h1>
              <div className="flex justify-between">
                <Input
                  name="search"
                  type="text"
                  className="w-96"
                  placeholder="search deal by title..."
                  onChange={(e) => {
                    params.search = e.target.value;
                    fetchDeals(params);
                  }}
                />
                <Button
                  type="button"
                  className="w-48 bg-purple-600 text-white p-2 rounded"
                  onClick={() => setShowForm(true)}
                >
                  Register New Deal
                </Button>
              </div>
              <Table<DealInterface>
                columns={columns}
                data={deals}
                actions={(deal) => (
                  <>
                    <Button type="button" onClick={() => findDeal(deal.id)}>
                      <img
                        alt="edit"
                        className="px-6 py-4 whitespace-no-wrap"
                        src="/assets/edit.svg"
                      />
                    </Button>
                    <Button type="button" onClick={() => deleteDeal(deal.id)}>
                      <img
                        className="px-6 py-4 whitespace-no-wrap"
                        src="/assets/delete.svg"
                        alt="delete"
                      />
                    </Button>
                  </>
                )}
              />
              <Pagination
                totalPages={totalPages}
                currentPage={params.page}
                onPageChange={handlePageChange}
              />
            </div>
          </div>
        </div>
      </section>
      {showForm && (
        <Modal isOpen={showForm} onClose={() => setShowForm(false)}>
          <DealForm
            initialValue={currentDeal || initialValue}
            onSubmit={handleFormSubmit}
            update={update}
          />
        </Modal>
      )}
    </>
  );
};

export default Deals;




// Table.tsx
import React from 'react';

interface TableProps<T> {
  columns: { header: string, accessor: keyof T }[];
  data: T[];
  actions?: (item: T) => React.ReactNode;
}

const Table = <T,>({ columns, data, actions }: TableProps<T>) => {
  return (
    <table className="min-w-full divide-y divide-gray-200">
      <thead className="bg-gray-50 dark:bg-gray-700">
        <tr>
          {columns.map((column) => (
            <th
              key={column.header}
              className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase"
            >
              {column.header}
            </th>
          ))}
          {actions && <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">Actions</th>}
        </tr>
      </thead>
      <tbody className="bg-white divide-y divide-gray-200">
        {data.map((item, index) => (
          <tr key={index}>
            {columns.map((column) => (
              <td
                key={String(column.accessor)}
                className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900"
              >
                {String(item[column.accessor])}
              </td>
            ))}
            {actions && (
              <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                {actions(item)}
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  );
};

export default Table;




