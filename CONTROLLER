import { NextFunction, Request, Response } from "express";
import { userInterface } from "../../interfaces/crmInterfaces";
import sendResponse from "../../helper/generalResponse";
import bcrypt from "bcryptjs";
import { v4 as uuidv4 } from 'uuid';
import { createUser, getUsersByEmailOrUsername } from "../../repository/userRepository";

export const register = async (req: Request<{},{},userInterface,{}>, res: Response): Promise<Response> => {
  try {
    const { username, email, password } = req.body;
    const id = uuidv4();
    const isUserExist: User[] = await getUsersByEmailOrUsername(email, username);
    const hashedPassword = await bcrypt.hash(password, 10);
    const newData: userInterface = { ...req.body, password: hashedPassword, id };

    if (isUserExist.length) {
      return sendResponse(res, { res: "exist" }, "Something went wrong", "server", 409);
    } else {
      const createdUser = await createUser(newData);
      return sendResponse(res, { res: createdUser }, "User inserted successfully", "success", 200);
    }
  } catch (error) {
    const e = error as Error;
    return sendResponse(res, "", "Something went wrong", "server", 500);
  }
};

export const logout = async (req: Request, res: Response): Promise<Response> => {
  try {
    res.clearCookie("token");
    return res.status(200).json("Logout successfully");
  } catch (error) {
    const e = error as Error;
    return res.status(500).json({ message: e.message });
  }
};
