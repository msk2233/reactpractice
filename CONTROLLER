import { Request, Response } from 'express';
import { userRepo } from './repositories'; // Adjust the import as per your structure
import { findAll, findOneById } from './baseRepo'; // Adjust the import as per your structure

export const getAllUsers = async (req: Request, res: Response) => {
  try {
    const users = await findAll(userRepo, req.query);
    res.json(users);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
};

export const getUserById = async (req: Request, res: Response) => {
  const { id } = req.params;
  try {
    const user = await findOneById(userRepo, id);
    if (!user) {
      res.status(404).json({ message: 'User not found' });
      return;
    }
    res.json(user);
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
};
