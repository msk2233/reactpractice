import { BaseRepoI } from './baseRepo';
import { User } from './user.entity'; // Adjust as per your entity setup

export const userRepo: BaseRepoI<User> = {
  findMany: async (options: Record<string, any>) => {
    // Implement your logic using Prisma or any other ORM
    const users = await prisma.user.findMany(options);
    return users;
  },
  findOne: async (id: string) => {
    // Implement your logic using Prisma or any other ORM
    const user = await prisma.user.findUnique({
      where: { id },
    });
    return user;
  },
};

