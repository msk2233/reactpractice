import { type PrismaClient } from "@prisma/client/extension";
import { options } from "joi";
const DEFAULT_ORDER_BY = {
  createdAt: "desc",
};
const MAX_RECORDS_LIMIT = 100;

export type BaseRepoI<T> = {
  findMany : (options:Record<string,any>) => Promise<T[]>
  findOne : (id:string) => Promise<T[]>
}

export const findAll = async<T>(model:BaseRepoI<T>,options: Record<string, any> = {})=>{
  if (!options.orderBy) {
    options.orderBy = DEFAULT_ORDER_BY;
  }
  if (!options.take || options.take > MAX_RECORDS_LIMIT) {
    options.take = MAX_RECORDS_LIMIT;
  }
  return model.findMany(options);
}

