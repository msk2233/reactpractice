import React, { useEffect, useState } from "react";
import axios from "axios";
import Navbar from "../common/Navbar";
import Button from "../common/Button";
import Input from "../common/Input";
import Modal from "../common/Modal"; // Import the modal component
import { Controller, useForm, SubmitHandler } from "react-hook-form";
import { yupResolver } from "@hookform/resolvers/yup";
import { companySchema } from "../../schema/regSchema";
import axiosInstance from "../../tokenconfig/tokenConfig";

export interface CompanyInterface {
  id?: string;
  name: string;
  address: string;
  email: string;
  phone: string;
  website: string;
}

const Company: React.FC = () => {
  const [companies, setCompanies] = useState<CompanyInterface[]>([]);
  const [showForm, setShowForm] = useState(false);
  const [formData, setFormData] = useState<CompanyInterface>();

  const {
    control,
    handleSubmit,
    reset,
    formState: { errors },
  } = useForm<CompanyInterface>({
    resolver: yupResolver(companySchema),
    mode: "onChange",
    defaultValues:formData
  });

  const fetchCompanies = async () => {
    try {
      const response = await axiosInstance.get('/companies');
      setCompanies(response.data.data.res);
    } catch (error) {
      console.error("Error fetching companies:", error);
    }
  };

  useEffect(() => {
    fetchCompanies();
  }, []);

  useEffect(() => {
    if (formData) {
      reset(formData); // Reset form values when formData changes
    }
  }, [formData, reset]);

  const deleteCompany = async (id: string | undefined) => {
    try {
      await axiosInstance.delete(`/companies/${id}`);
      fetchCompanies();
    } catch (error) {
      console.error("Error deleting company:", error);
    }
  };

  const onSubmit: SubmitHandler<CompanyInterface> = async (data) => {
    try {
      const token = localStorage.getItem("authtoken");
      if (token) {
        const config = {
          headers: { Authorization: `Bearer ${token}` },
        };
        if (formData?.id) {
          await axios.put(
            `http://localhost:6060/companies/${formData.id}`,
            data,
            config
          );
        } else {
          const response = await axios.post(
            "http://localhost:6060/companies",
            data,
            config
          );
          setCompanies([...companies, response.data.data.res]);
        }
        setShowForm(false);
        fetchCompanies();
      }
    } catch (error) {
      console.error("There was an error!", error);
    }
  };

  const findCompany = async (id: string | undefined) => {
    try {
      const response = await axiosInstance.get(`/companies/${id}`);
      setFormData(response.data.data);
      setShowForm(true);
      reset(response.data.data); // Populate form with company data
    } catch (error) {
      console.error("Error fetching company:", error);
    }
  };

  return (
    <>
      <Navbar />
      <section className="bg-gray-50 light:bg-gray">
        <div className="flex flex-col items-center justify-center lg:py-0">
          <div className="w-full max-w-9xl bg-white rounded-lg shadow md:mt-0 sm:overflow-x-auto light:bg-gray-800 light:border-gray-700">
            <div className="p-6 space-y-4 md:space-y-6 sm:p-8">
              <h1 className="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl light:text-white">
                Company Records
              </h1>
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-50 light:bg-gray-700">
                  <tr>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Name
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Address
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Email
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Phone
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Website
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Delete
                    </th>
                    <th className="px-6 py-3 text-xs font-medium leading-4 tracking-wider text-left text-gray-500 uppercase">
                      Edit
                    </th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {companies.length > 0 &&
                    companies.map((company) => (
                      <tr key={company.id}>
                        <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                          {company.name}
                        </td>
                        <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                          {company.address}
                        </td>
                        <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                          {company.email}
                        </td>
                        <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                          {company.phone}
                        </td>
                        <td className="px-6 py-4 whitespace-no-wrap text-sm leading-5 text-gray-900">
                          <a
                            href={company.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="text-blue-500 hover:text-blue-700"
                          >
                            {company.website}
                          </a>
                        </td>
                        <td>
                          <div>
                            <Button
                              type="button"
                              onClick={() => deleteCompany(company.id)}
                            >
                              <img
                                className="px-6 py-4 whitespace-no-wrap"
                                src="/assets/delete.svg"
                                alt="delete"
                              />
                            </Button>
                          </div>
                        </td>
                        <td>
                          <div>
                            <Button
                              type="button"
                              onClick={() => findCompany(company.id)}
                            >
                              <img
                                alt="edit"
                                className="px-6 py-4 whitespace-no-wrap"
                                src="/assets/edit.svg"
                              />
                            </Button>
                          </div>
                        </td>
                      </tr>
                    ))}
                </tbody>
              </table>
              <Button
                type="button"
                onClick={() => {
                  setShowForm(!showForm);
                  // Reset formData when opening the form for a new company
                }}
                className="bg-purple-600 text-white p-2 rounded hover:bg-purple-700 focus:ring-4 focus:outline-none focus:ring-purple-300 absolute top-20 right-4"
              >
                {showForm ? "Hide Form" : "Register Company"}
              </Button>
            </div>
          </div>
        </div>
      </section>

      <Modal isOpen={showForm} onClose={() => setShowForm(false)}>
        <form
          className="space-y-4 md:space-y-6"
          onSubmit={handleSubmit(onSubmit)}
        >
          <div>
            <label
              htmlFor="name"
              className="block mb-2 text-sm font-medium text-gray-900 light:text-white"
            >
              Name
            </label>
            <Controller
              name="name"
              control={control}
              render={({ field }) => (
                <Input
                  type="text"
                  placeholder="Company Name"
                  {...field}
                  className="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-purple-600 focus:border-purple-600 light:bg-gray-700 light:border-gray-600 light:placeholder-gray-400 light:text-white light:focus:ring-purple-500 light:focus:border-purple-500"
                />
              )}
            />
            {errors.name && (
              <p className="text-red-600">{errors.name.message}</p>
