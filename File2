

import { AppDispatch } from "../store"; // Import your AppDispatch type

export const login = (userData: User) => async (dispatch: AppDispatch) => {
  dispatch(loginStart());
  try {
    const response = await axiosInstance.post("/login", userData);
    const resData = response.data;
    localStorage.setItem("userInfo", JSON.stringify(resData.res));
    dispatch(loginSuccess(resData.res));
  } catch (error) {
    dispatch(loginFailure(error.toString()));
  }
};

export const register = (userData: forAuthslice) => async (dispatch: AppDispatch) => {
  dispatch(registerStart());
  try {
    const response = await axiosInstance.post("/register", userData);
    const resData = response.data;
    localStorage.setItem("userInfo", JSON.stringify(resData));
    dispatch(registerSuccess(resData));
  } catch (error) {
    dispatch(registerFailure(error.toString()));
  }
};
